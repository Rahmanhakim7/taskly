# Database PostgreSQL (wajib)
# Contoh: postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Aktifkan jika provider database mewajibkan SSL dan URL tidak memuat sslmode
DATABASE_SSL=false

# Session (wajib di production)
SESSION_SECRET=replace_with_a_long_random_secret

# Origin frontend untuk CORS (wajib di production)
# Contoh production: https://nama-frontend.vercel.app
# Beberapa origin dapat dipisahkan dengan koma.
FRONTEND_URL=http://localhost:5173

# Runtime
NODE_ENV=development
